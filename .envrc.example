# cp this to .envrc, fill in the real token, then run `direnv allow`.
# .envrc itself is gitignored — never commit the real token.

export TANZU_HUB_USERNAME="someone@broadcom.com"
export TANZU_HUB_TOKEN="paste-the-broadcom-support-portal-token-here"

# Uncomment after running ./trust-advisor-cert.sh once, so the Application
# Advisor CLI picks up Hub's self-signed cert automatically instead of
# needing APP_ADVISOR_OPTIONS_CERT_PATH=... on every command. (The Advisor
# CLI is a GraalVM native-image binary, not a `java` launcher, so it does NOT
# honor JDK_JAVA_OPTIONS — this env var is read by the app itself instead.)
# export APP_ADVISOR_OPTIONS_CERT_PATH="$PWD/server-cert.pem"
